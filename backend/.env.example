# BhoomiGuard AI Environment Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=BhoomiGuard AI
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# Security
SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=sqlite:///./bhoomiguard.db

# Paths
DATA_DIR=../data
MODELS_DIR=./models_store
DATASET_FILENAME=land_acquisition_delay_dataset_10000.csv

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Risk Thresholds (configurable)
RISK_LOW_MAX=0.25
RISK_MEDIUM_MAX=0.50
RISK_HIGH_MAX=0.75
# Above HIGH_MAX is Critical
